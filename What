-- TOGGLE
getgenv().autotrain = true

-- VARIABLES
local Players = game:GetService("Players")
local player = Players.LocalPlayer

local currentTool = nil
local lastCheck = 0
local CHECK_INTERVAL = 1 -- seconds

while getgenv().autotrain do
    local now = os.clock()

    -- Recheck tool every 1 second
    if now - lastCheck >= CHECK_INTERVAL then
        local char = player.Character or player.CharacterAdded:Wait()
        currentTool = char:FindFirstChildOfClass("Tool")
        lastCheck = now
    end

    -- Spam activate (FAST)
    if currentTool then
        currentTool:Activate()
    end

    task.wait() -- frame-based spam (~30–60 times/sec)
end


-- Always-On Noclip (Press N to toggle OFF/ON)

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local noclip = true
local connection

local function enableNoclip()
	connection = RunService.Stepped:Connect(function()
		if player.Character then
			for _, part in ipairs(player.Character:GetDescendants()) do
				if part:IsA("BasePart") then
					part.CanCollide = false
				end
			end
		end
	end)
end

local function disableNoclip()
	if connection then
		connection:Disconnect()
		connection = nil
	end
end

-- Start noclip ON
enableNoclip()

-- Toggle with N
UserInputService.InputBegan:Connect(function(input, gp)
	if gp then return end
	if input.KeyCode == Enum.KeyCode.N then
		noclip = not noclip
		if noclip then
			enableNoclip()
			print("Noclip: ON")
		else
			disableNoclip()
			print("Noclip: OFF")
		end
	end
end)
