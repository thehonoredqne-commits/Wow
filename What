-- Get the local player
local player = game.Players.LocalPlayer

-- Services to scan
local servicesToCheck = {
    game:GetService("ReplicatedStorage"),
    game:GetService("Workspace"),
    game:GetService("ClientStorage") -- only if it exists
}

-- Recursive function to scan folders
local function ScanForRemotes(parent, path)
    for _, child in ipairs(parent:GetChildren()) do
        local childPath = path.."/"..child.Name
        if child:IsA("RemoteEvent") then
            print("[RemoteEvent] Found at: "..childPath)
        elseif child:IsA("RemoteFunction") then
            print("[RemoteFunction] Found at: "..childPath)
        elseif child:IsA("Folder") or child:IsA("ModuleScript") or child:IsA("Configuration") then
            -- Recurse into folders, modules, or configs
            ScanForRemotes(child, childPath)
        end
    end
end

-- Run the scan for each service
for _, service in ipairs(servicesToCheck) do
    if service then
        ScanForRemotes(service, service.Name)
    end
end

print("✅ Scan complete! Check the Output for all RemoteEvents/RemoteFunctions.")
