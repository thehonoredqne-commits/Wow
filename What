-- TOGGLE
getgenv().autotrain = true

-- VARIABLES
local Players = game:GetService("Players")
local player = Players.LocalPlayer

local currentTool = nil
local lastCheck = 0
local CHECK_INTERVAL = 1 -- seconds

while getgenv().autotrain do
    local now = os.clock()

    -- Recheck tool every 1 second
    if now - lastCheck >= CHECK_INTERVAL then
        local char = player.Character or player.CharacterAdded:Wait()
        currentTool = char:FindFirstChildOfClass("Tool")
        lastCheck = now
    end

    -- Spam activate (FAST)
    if currentTool then
        currentTool:Activate()
    end

    task.wait() -- frame-based spam (~30–60 times/sec)
end


-- TOGGLE
getgenv().autoPress = true

local Players = game:GetService("Players")
local player = Players.LocalPlayer
local VIM = game:GetService("VirtualInputManager")

local BUTTON_ORDER = {
    "swordimgbtn",
    "classimgbtn",
    "ascendimgbtn"
}

local function clickButton(button)
    local pos = button.AbsolutePosition
    local size = button.AbsoluteSize

    local x = pos.X + size.X / 2
    local y = pos.Y + size.Y / 2

    -- mouse down
    VIM:SendMouseButtonEvent(x, y, 0, true, game, 0)
    task.wait(0.05)
    -- mouse up
    VIM:SendMouseButtonEvent(x, y, 0, false, game, 0)
end

while getgenv().autoPress do
    local playerGui = player:WaitForChild("PlayerGui")

    for _, buttonName in ipairs(BUTTON_ORDER) do
        local button = playerGui:FindFirstChild(buttonName, true)
        if button and button:IsA("GuiButton") then
            clickButton(button)
        end
        task.wait(0.3) -- wait between each button
    end
end
