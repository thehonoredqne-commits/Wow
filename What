-- Roblox Crosshair & Click Button Script
local player = game.Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

-- Create ScreenGui
local gui = Instance.new("ScreenGui")
gui.Parent = playerGui
gui.Name = "CrosshairGui"

-- Crosshair
local crosshair = Instance.new("Frame")
crosshair.Size = UDim2.new(0, 10, 0, 10) -- small square crosshair
crosshair.Position = UDim2.new(0.5, 15, 0.5, 0) -- slightly right of center
crosshair.AnchorPoint = Vector2.new(0.5, 0.5)
crosshair.BackgroundColor3 = Color3.new(1, 0, 0) -- red
crosshair.BorderSizePixel = 0
crosshair.Parent = gui

-- Click Button
local clickButton = Instance.new("TextButton")
clickButton.Size = UDim2.new(0, 120, 0, 40)
clickButton.Position = UDim2.new(0.5, -60, 0.9, 0) -- bottom middle
clickButton.AnchorPoint = Vector2.new(0.5, 0.5)
clickButton.Text = "Click Crosshair"
clickButton.BackgroundColor3 = Color3.new(0, 0.5, 1)
clickButton.TextColor3 = Color3.new(1, 1, 1)
clickButton.Parent = gui

-- Function to simulate click at crosshair
clickButton.MouseButton1Click:Connect(function()
    local mouse = player:GetMouse()
    -- Use MouseLocation to move mouse virtually (for GUI detection)
    local x = crosshair.AbsolutePosition.X + crosshair.AbsoluteSize.X/2
    local y = crosshair.AbsolutePosition.Y + crosshair.AbsoluteSize.Y/2
    mouse.TargetFilter = nil
    -- Fire MouseButton1Down/Up at position
    local virtualInput = game:GetService("VirtualInputManager")
    virtualInput:SendMouseButtonEvent(x, y, 0, true, game, 0) -- MouseButton1Down
    virtualInput:SendMouseButtonEvent(x, y, 0, false, game, 0) -- MouseButton1Up
end)
