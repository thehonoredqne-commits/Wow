-- TOGGLE
getgenv().autotrain = true

-- VARIABLES
local Players = game:GetService("Players")
local player = Players.LocalPlayer

local currentTool = nil
local lastCheck = 0
local CHECK_INTERVAL = 1 -- seconds

while getgenv().autotrain do
    local now = os.clock()

    -- Recheck tool every 1 second
    if now - lastCheck >= CHECK_INTERVAL then
        local char = player.Character or player.CharacterAdded:Wait()
        currentTool = char:FindFirstChildOfClass("Tool")
        lastCheck = now
    end

    -- Spam activate (FAST)
    if currentTool then
        currentTool:Activate()
    end

    task.wait() -- frame-based spam (~30–60 times/sec)
end



-- TOGGLE
getgenv().autoUpgrade = true

local Players = game:GetService("Players")
local player = Players.LocalPlayer

local CHECK_INTERVAL = 1
local lastCheck = 0
local upgradeButton = nil

while getgenv().autoUpgrade do
    local now = os.clock()

    -- Re-scan UI every 1 second
    if now - lastCheck >= CHECK_INTERVAL then
        upgradeButton = nil

        local playerGui = player:WaitForChild("PlayerGui")

        for _, gui in ipairs(playerGui:GetDescendants()) do
            if gui.Name == "Upgradetxt" then
                local parent = gui.Parent
                if parent and parent:IsA("GuiButton") then
                    upgradeButton = parent
                    break
                end
            end
        end

        lastCheck = now
    end

    -- Spam activate if found
    if upgradeButton then
        upgradeButton:Activate()
    end

    task.wait() -- frame-based spam
end
