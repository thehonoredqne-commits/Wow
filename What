-- SERVICES
local Players = game:GetService("Players")
local VirtualInputManager = game:GetService("VirtualInputManager")

local player = Players.LocalPlayer

-- GUI
local gui = Instance.new("ScreenGui")
gui.Name = "ClickCirclesGUI"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

-- SETTINGS
local CLICK_DELAY = 1.05

-- STATES
local clickingEnabled = true
local circlesHidden = false

-- STORAGE
local circles = {}

-- CREATE CIRCLE
local function createCircle(index, pos)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.fromOffset(50, 50)
    btn.Position = pos
    btn.Text = tostring(index)
    btn.TextSize = 22
    btn.Font = Enum.Font.SourceSansBold
    btn.TextColor3 = Color3.new(1,1,1)
    btn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
    btn.AutoButtonColor = false
    btn.Draggable = true
    btn.Active = true
    btn.Parent = gui

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(1, 0)
    corner.Parent = btn

    circles[index] = btn
end

-- CREATE 4 CIRCLES
for i = 1, 4 do
    createCircle(i, UDim2.new(0, 20, 0, 60 * i))
end

-- CLICK LOOP
task.spawn(function()
    while true do
        if clickingEnabled then
            for _, btn in pairs(circles) do
                if btn and btn.Parent then
                    local absPos = btn.AbsolutePosition
                    local absSize = btn.AbsoluteSize
                    local x = absPos.X + absSize.X / 2
                    local y = absPos.Y + absSize.Y / 2

                    VirtualInputManager:SendMouseButtonEvent(
                        x, y, 0, true, game, 0
                    )
                    task.wait()
                    VirtualInputManager:SendMouseButtonEvent(
                        x, y, 0, false, game, 0
                    )
                end
            end
        end
        task.wait(CLICK_DELAY)
    end
end)

-- CREATE CONTROL BUTTON
local function createControlButton(text, pos, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.fromOffset(160, 40)
    btn.Position = pos
    btn.Text = text
    btn.TextSize = 16
    btn.Font = Enum.Font.SourceSansBold
    btn.TextColor3 = Color3.new(1,1,1)
    btn.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
    btn.Parent = gui
    btn.MouseButton1Click:Connect(callback)
    return btn
end

-- CLICK TOGGLE BUTTON
local clickToggle = createControlButton(
    "Clicking: ON",
    UDim2.new(0, 20, 0, 320),
    function()
        clickingEnabled = not clickingEnabled
        clickToggle.Text = clickingEnabled and "Clicking: ON" or "Clicking: OFF"
    end
)

-- VISIBILITY TOGGLE BUTTON
local visibilityToggle = createControlButton(
    "Circles: Visible",
    UDim2.new(0, 20, 0, 370),
    function()
        circlesHidden = not circlesHidden
        for _, btn in pairs(circles) do
            btn.BackgroundTransparency = circlesHidden and 1 or 0
            btn.TextTransparency = circlesHidden and 1 or 0
        end
        visibilityToggle.Text = circlesHidden and "Circles: Hidden" or "Circles: Visible"
    end
)
