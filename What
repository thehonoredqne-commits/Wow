-- =========================
-- TOGGLE SETTINGS
-- =========================
getgenv().autotrain = true
local autoClickEnabled = true
local hoverEnabled = true -- hover toggle
local DELAY = 0.3 -- click delay

-- =========================
-- SERVICES & VARIABLES
-- =========================
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local VirtualInputManager = game:GetService("VirtualInputManager")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local hrp = character:WaitForChild("HumanoidRootPart")
local humanoid = character:WaitForChild("Humanoid")
local playerGui = player:WaitForChild("PlayerGui")
local Mouse = player:GetMouse()

-- =========================
-- AUTO TRAIN
-- =========================
local currentTool = nil
local lastCheck = 0
local CHECK_INTERVAL = 1 -- seconds

task.spawn(function()
    while getgenv().autotrain do
        local now = os.clock()

        -- Recheck tool every 1 second
        if now - lastCheck >= CHECK_INTERVAL then
            character = player.Character or player.CharacterAdded:Wait()
            currentTool = character:FindFirstChildOfClass("Tool")
            lastCheck = now
        end

        -- Spam activate (FAST)
        if currentTool then
            currentTool:Activate()
        end

        task.wait() -- frame-based spam (~30–60 times/sec)
    end
end)

-- =========================
-- TELEPORT ONCE
-- =========================
local TELEPORT_POSITION = Vector3.new(-435, 3500, -444)
local teleported = false

local function teleportOnce()
    if teleported then return end
    teleported = true

    character = player.Character or player.CharacterAdded:Wait()
    local hrp = character:WaitForChild("HumanoidRootPart")
    hrp.CFrame = CFrame.new(TELEPORT_POSITION)
end

teleportOnce()

-- =========================
-- HOVER NOCLIP
-- =========================
local hoverY = hrp.Position.Y

RunService.Stepped:Connect(function()
    if hoverEnabled and character and hrp then
        local pos = hrp.Position
        hrp.Velocity = Vector3.new(0, 0, 0) -- stop vertical movement
        hrp.CFrame = CFrame.new(Vector3.new(pos.X, hoverY, pos.Z))

        -- Disable collisions for character parts
        for _, part in pairs(character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end
end)

-- Toggle hover with "H" key
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.H then
        hoverEnabled = not hoverEnabled
        print("Hover toggled:", hoverEnabled)
    end
end)

-- =========================
-- EZPI-STYLE AUTO CLICKER
-- =========================

-- GUI button coordinates (change if needed)
local UPGRADE_BTN = {900, 420}
local NO_BTN      = {960, 560}
local PROMOTE_BTN = {900, 620}
local ASCEND_BTN  = {900, 720}

-- Click function using Ezpi-style VirtualInputManager
local function clickAt(x, y, interval)
    interval = interval or DELAY
    -- Press
    VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 1)
    -- Release
    VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 1)
    task.wait(interval)
end

-- Auto click loop
task.spawn(function()
    while autoClickEnabled do
        clickAt(UPGRADE_BTN[1], UPGRADE_BTN[2], DELAY)
        clickAt(NO_BTN[1], NO_BTN[2], DELAY)
        clickAt(PROMOTE_BTN[1], PROMOTE_BTN[2], DELAY)
        clickAt(ASCEND_BTN[1], ASCEND_BTN[2], DELAY)
    end
end)
