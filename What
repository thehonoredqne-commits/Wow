-- Teleport Behind Enemy on Touch
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
local humanoidRootPart = character:WaitForChild("HumanoidRootPart")

local TELEPORT_DISTANCE = 3 -- studs behind the enemy
local COOLDOWN = 1
local canTP = true

local function onTouched(hit)
	if not canTP then return end

	local enemyChar = hit.Parent
	if not enemyChar then return end

	local enemyHumanoid = enemyChar:FindFirstChild("Humanoid")
	local enemyRoot = enemyChar:FindFirstChild("HumanoidRootPart")

	-- Make sure it's another player
	if enemyHumanoid and enemyRoot and enemyChar ~= character then
		canTP = false

		-- Position behind enemy
		local behindPosition = enemyRoot.CFrame * CFrame.new(0, 0, -TELEPORT_DISTANCE)

		-- Face same direction as enemy (their back)
		humanoidRootPart.CFrame = CFrame.new(
			behindPosition.Position,
			behindPosition.Position + enemyRoot.CFrame.LookVector
		)

		task.delay(COOLDOWN, function()
			canTP = true
		end)
	end
end

-- Detect touch
humanoidRootPart.Touched:Connect(onTouched)
