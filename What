-- SERVICES
local Players = game:GetService("Players")
local VirtualInputManager = game:GetService("VirtualInputManager")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer

-- GUI
local gui = Instance.new("ScreenGui")
gui.Name = "ClickCirclesGUI"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

-- SETTINGS
local CLICK_DELAY = 0.15 -- click speed

-- STORAGE
local circles = {}

-- CREATE CIRCLE FUNCTION
local function createCircle(index, pos)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.fromOffset(50, 50)
    btn.Position = pos
    btn.Text = tostring(index)
    btn.TextSize = 22
    btn.Font = Enum.Font.SourceSansBold
    btn.TextColor3 = Color3.new(1,1,1)
    btn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
    btn.AutoButtonColor = false
    btn.Draggable = true
    btn.Active = true
    btn.Parent = gui

    -- Make it a circle
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(1, 0)
    corner.Parent = btn

    circles[index] = btn
end

-- CREATE 4 CIRCLES
for i = 1, 4 do
    createCircle(i, UDim2.new(0, 20, 0, 60 * i))
end

-- CLICK LOOP
task.spawn(function()
    while true do
        for _, btn in pairs(circles) do
            if btn and btn.Parent then
                local absPos = btn.AbsolutePosition
                local absSize = btn.AbsoluteSize

                local x = absPos.X + absSize.X / 2
                local y = absPos.Y + absSize.Y / 2

                -- Mouse click (Left Click)
                VirtualInputManager:SendMouseButtonEvent(
                    x,
                    y,
                    0,      -- Left mouse button
                    true,   -- Button down
                    game,
                    0
                )
                task.wait()
                VirtualInputManager:SendMouseButtonEvent(
                    x,
                    y,
                    0,
                    false,  -- Button up
                    game,
                    0
                )
            end
        end
        task.wait(CLICK_DELAY)
    end
end)
