-- TOGGLE
getgenv().autotrain = true

-- VARIABLES
local Players = game:GetService("Players")
local player = Players.LocalPlayer

local currentTool = nil
local lastCheck = 0
local CHECK_INTERVAL = 1 -- seconds

while getgenv().autotrain do
    local now = os.clock()

    -- Recheck tool every 1 second
    if now - lastCheck >= CHECK_INTERVAL then
        local char = player.Character or player.CharacterAdded:Wait()
        currentTool = char:FindFirstChildOfClass("Tool")
        lastCheck = now
    end

    -- Spam activate (FAST)
    if currentTool then
        currentTool:Activate()
    end

    task.wait() -- frame-based spam (~30–60 times/sec)
end


-- TOGGLE
getgenv().autoPress = true

local Players = game:GetService("Players")
local player = Players.LocalPlayer

-- button names to press
local BUTTON_NAMES = {
    "swordimgbtn",
    "classimgbtn",
    "ascendimgbtn"
}

while getgenv().autoPress do
    local playerGui = player:WaitForChild("PlayerGui")

    for _, name in ipairs(BUTTON_NAMES) do
        local button = playerGui:FindFirstChild(name, true)

        if button and button:IsA("GuiButton") then
            button:Activate() -- acts like a real click
        end
    end

    task.wait() -- presses once per second
end
