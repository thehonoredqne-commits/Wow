-- =========================
-- TOGGLE SETTINGS
-- =========================
getgenv().autotrain = true
local autoClickEnabled = true
local noclipEnabled = true -- safe noclip toggle

-- =========================
-- SERVICES & VARIABLES
-- =========================
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local VirtualUser = game:GetService("VirtualUser")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local humanoidRootPart = character:WaitForChild("HumanoidRootPart")

-- =========================
-- AUTO TRAIN
-- =========================
local currentTool = nil
local lastCheck = 0
local CHECK_INTERVAL = 1 -- seconds

task.spawn(function()
    while getgenv().autotrain do
        local now = os.clock()

        -- Recheck tool every 1 second
        if now - lastCheck >= CHECK_INTERVAL then
            character = player.Character or player.CharacterAdded:Wait()
            currentTool = character:FindFirstChildOfClass("Tool")
            lastCheck = now
        end

        -- Spam activate (FAST)
        if currentTool then
            currentTool:Activate()
        end

        task.wait() -- frame-based spam (~30–60 times/sec)
    end
end)

-- =========================
-- TELEPORT ONCE
-- =========================
local TELEPORT_POSITION = Vector3.new(-435, 128, -444)
local teleported = false

local function teleportOnce()
    if teleported then return end
    teleported = true

    character = player.Character or player.CharacterAdded:Wait()
    local hrp = character:WaitForChild("HumanoidRootPart")
    hrp.CFrame = CFrame.new(TELEPORT_POSITION)
end

teleportOnce()

-- =========================
-- SAFE NOCLIP
-- =========================
local noclipConnection

local function toggleNoclip(enabled)
    noclipEnabled = enabled

    if noclipConnection then
        noclipConnection:Disconnect()
        noclipConnection = nil
    end

    if noclipEnabled then
        noclipConnection = RunService.Stepped:Connect(function()
            local character = player.Character
            if not character then return end
            local hrp = character:FindFirstChild("HumanoidRootPart")
            if not hrp then return end

            for _, part in pairs(character:GetDescendants()) do
                if part:IsA("BasePart") then
                    -- Only disable collisions for non-floor parts
                    if part ~= hrp and part.Position.Y > hrp.Position.Y - 3 then
                        part.CanCollide = false
                    else
                        part.CanCollide = true
                    end
                end
            end
        end)
    else
        local character = player.Character
        if character then
            for _, part in pairs(character:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = true
                end
            end
        end
    end
end

-- Enable safe noclip immediately
toggleNoclip(true)

-- Optional: Toggle with "N" key
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.N then
        toggleNoclip(not noclipEnabled)
        print("Safe noclip toggled:", noclipEnabled)
    end
end)

-- =========================
-- COORDINATE-BASED AUTO CLICKER (MOUSE)
-- =========================
local DELAY = 0.3

-- === EDIT THESE COORDINATES ===
local UPGRADE_BTN = {900, 420}
local NO_BTN      = {960, 560}
local PROMOTE_BTN = {900, 620}
local ASCEND_BTN  = {900, 720}

local function click(x, y)
    VirtualUser:CaptureController()
    VirtualUser:ClickButton1(Vector2.new(x, y))
end

task.spawn(function()
    while autoClickEnabled do
        click(UPGRADE_BTN[1], UPGRADE_BTN[2])
        task.wait(DELAY)

        click(NO_BTN[1], NO_BTN[2])
        task.wait(DELAY)

        click(PROMOTE_BTN[1], PROMOTE_BTN[2])
        task.wait(DELAY)

        click(ASCEND_BTN[1], ASCEND_BTN[2])
        task.wait(DELAY)
    end
end)
