-- =========================
-- TOGGLE SETTINGS
-- =========================
getgenv().autotrain = true
local autoClickEnabled = true
local hoverEnabled = true -- hover toggle

-- =========================
-- SERVICES & VARIABLES
-- =========================
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local hrp = character:WaitForChild("HumanoidRootPart")
local humanoid = character:WaitForChild("Humanoid")
local playerGui = player:WaitForChild("PlayerGui")

-- =========================
-- AUTO TRAIN
-- =========================
local currentTool = nil
local lastCheck = 0
local CHECK_INTERVAL = 1 -- seconds

task.spawn(function()
    while getgenv().autotrain do
        local now = os.clock()

        -- Recheck tool every 1 second
        if now - lastCheck >= CHECK_INTERVAL then
            character = player.Character or player.CharacterAdded:Wait()
            currentTool = character:FindFirstChildOfClass("Tool")
            lastCheck = now
        end

        -- Spam activate (FAST)
        if currentTool then
            currentTool:Activate()
        end

        task.wait() -- frame-based spam (~30–60 times/sec)
    end
end)

-- =========================
-- TELEPORT ONCE
-- =========================
local TELEPORT_POSITION = Vector3.new(-435, 128, -444)
local teleported = false

local function teleportOnce()
    if teleported then return end
    teleported = true

    character = player.Character or player.CharacterAdded:Wait()
    local hrp = character:WaitForChild("HumanoidRootPart")
    hrp.CFrame = CFrame.new(TELEPORT_POSITION)
end

teleportOnce()

-- =========================
-- HOVER NOCLIP
-- =========================
local hoverY = hrp.Position.Y

RunService.Stepped:Connect(function()
    if hoverEnabled and character and hrp then
        local pos = hrp.Position
        hrp.Velocity = Vector3.new(0, 0, 0) -- stop vertical movement
        hrp.CFrame = CFrame.new(Vector3.new(pos.X, hoverY, pos.Z))

        -- Disable collisions for character parts
        for _, part in pairs(character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end
end)

-- Toggle hover with "H" key
local UserInputService = game:GetService("UserInputService")
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.H then
        hoverEnabled = not hoverEnabled
        print("Hover toggled:", hoverEnabled)
    end
end)

-- =========================
-- BUTTON AUTO CLICKER (DIRECT EVENTS)
-- =========================
local DELAY = 0.3

-- Wait for the buttons to exist in GUI
local swordBtn   = playerGui:WaitForChild("SwordImgBtn")
local classBtn   = playerGui:WaitForChild("ClassImgBtn")
local ascendBtn  = playerGui:WaitForChild("AscendImgBtn")

-- Function to safely fire button
local function fireButton(btn)
    if btn and btn.Activated then
        btn.Activated:Fire()
    end
end

task.spawn(function()
    while autoClickEnabled do
        fireButton(swordBtn)
        task.wait(DELAY)

        fireButton(classBtn)
        task.wait(DELAY)

        fireButton(ascendBtn)
        task.wait(DELAY)
    end
end)
