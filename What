-- SERVICES
local Players = game:GetService("Players")
local VirtualInputManager = game:GetService("VirtualInputManager")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer

-- GUI
local gui = Instance.new("ScreenGui")
gui.Name = "TapCirclesGUI"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

-- SETTINGS
local TAP_DELAY = 0.15 -- tap speed

-- STORAGE
local circles = {}

-- CREATE CIRCLE FUNCTION
local function createCircle(index, pos)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.fromOffset(50, 50)
    btn.Position = pos
    btn.Text = tostring(index)
    btn.TextSize = 22
    btn.Font = Enum.Font.SourceSansBold
    btn.TextColor3 = Color3.new(1,1,1)
    btn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
    btn.AutoButtonColor = false
    btn.Draggable = true
    btn.Active = true
    btn.Parent = gui

    -- Round shape
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(1, 0)
    corner.Parent = btn

    circles[index] = {
        button = btn,
        enabled = true
    }
end

-- CREATE 4 CIRCLES
for i = 1, 4 do
    createCircle(i, UDim2.new(0, 20, 0, 60 * i))
end

-- TAP LOOP
task.spawn(function()
    while true do
        for _, data in pairs(circles) do
            local btn = data.button
            if btn and btn.Parent then
                local absPos = btn.AbsolutePosition
                local absSize = btn.AbsoluteSize
                local x = absPos.X + absSize.X / 2
                local y = absPos.Y + absSize.Y / 2

                -- Mobile tap simulation
                VirtualInputManager:SendTouchEvent(0, Enum.UserInputState.Begin, x, y)
                task.wait()
                VirtualInputManager:SendTouchEvent(0, Enum.UserInputState.End, x, y)
            end
        end
        task.wait(TAP_DELAY)
    end
end)
