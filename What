-- Helper function to safely invoke a remote
local function SafeInvoke(remote, args)
    if remote and remote.InvokeServer then
        pcall(function()
            remote:InvokeServer(unpack(args))
        end)
    else
        warn("Remote not found or invalid!")
    end
end

-- Auto Upgrade Functions
local function AutoUpdateSword()
    local remote = game:GetService("ClientStorage"):WaitForChild("Client"):WaitForChild("Services"):WaitForChild("PersonalRemoteService")
    local args = {remote, "e1ec24ca-4bae-42fa-abe0-dd42c86bfee7", "0.015175382731637717", "2dc11f3a-8f78-482c-8ec1-18d8609ebc46"}
    while true do
        SafeInvoke(remote, args)
        wait(0.2)
    end
end

